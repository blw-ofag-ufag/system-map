# ==============================================================================
# PREFIXES
# ==============================================================================

@prefix keyword: <https://agriculture.ld.admin.ch/system-map/keyword/> .
@prefix schema: <http://schema.org/> .

# ==============================================================================
# KEYWORD DEFINITIONS
# ==============================================================================

keyword:agriculturalcontrol a schema:DefinedTerm ;
    schema:name "Landwirtschaftliche Kontrolle"@de ,
        "Agricultural control"@en ,
        "Contrôle agricole"@fr ,
        "Controllo agricolo"@it .

